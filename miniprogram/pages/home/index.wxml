<wxs module="characterFade" src="../../utils/character-opacity.wxs" />
<template name="copy-text">
  <text class="copy-reveal reveal" data-key="copy-{{run.id}}" aria-label="{{run.text}}"><text aria-hidden="true"><text wx:for="{{characterFade.runs(run, progress)}}" wx:for-item="segment" wx:key="id" class="copy-char" style="opacity:{{segment.opacity}}">{{segment.text}}</text></text></text>
</template>
<page-meta page-style="{{contactVisible ? 'overflow: hidden;' : 'overflow-x: hidden;'}}" />
<view class="ui-box portfolio {{!motionActive || contactVisible || menuOpen ? 'motion-paused' : ''}} {{revealEnabled ? 'reveal-ready' : ''}}" bindtap="closeHeroContact">
  <view class="ui-box atmosphere" aria-hidden="true"><star-atmosphere class="star-background" active="{{motionActive && !contactVisible && !menuOpen}}" /></view>
  <view class="ui-box navigation" style="padding-top:{{statusHeight}}px;" aria-role="navigation" aria-label="分区导航">
    <button hover-class="tap-pressed" class="ui-box ui-button navigation-row" style="width:calc(100% - {{menuRight}}px);" bindtap="toggleMenu" bindtouchstart="onMenuTouchStart" catchtouchmove="onMenuTouchMove" bindtouchend="onMenuTouchEnd" bindtouchcancel="onMenuTouchCancel" aria-label="{{menuOpen ? '收起导航菜单' : '展开导航菜单，也可向下拉动展开'}}" aria-expanded="{{menuOpen}}">
      <text class="brand">KT</text><text class="current-section" style="max-width:calc(100vw - {{menuRight * 2}}px);">{{activeLabel}}</text>
    </button>
    <scroll-view wx:if="{{menuOpen}}" class="menu-track" scroll-x="{{true}}" scroll-into-view="nav-{{sections[pullIndex].id}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <button hover-class="tap-pressed" wx:for="{{sections}}" wx:key="id" id="nav-{{item.id}}" class="ui-box ui-button menu-item {{index === pullIndex ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="navigateSection">{{item.label}}</button>
    </scroll-view>
  </view>
  <view wx:if="{{menuOpen}}" class="ui-box menu-dismiss" style="top:{{headerHeight + 64}}px;" bindtap="closeMenu" aria-label="关闭导航菜单" />
  <view id="hero" class="ui-box hero anchor" style="padding-top:{{heroTitleTop}}px;">
    <view class="ui-box hero-title {{titlePressed ? 'title-pressed' : ''}} reveal visibility-target {{revealed.hero ? 'is-revealed' : ''}}" data-key="hero" aria-label="你好，我叫康彤">
      <distorted-title class="shader-title" source="/assets/titles/hero.png" label="你好，我叫康彤" hero="{{true}}" active="{{motionActive && !menuOpen && !contactVisible && revealed.hero}}"><view class="ui-box title-line"><view class="ui-box title-glyph"><text class="title-glyph-text">你</text></view><view class="ui-box title-glyph"><text class="title-glyph-text">好</text></view></view>
      <view class="ui-box title-line second"><view class="ui-box title-glyph"><text class="title-glyph-text">我</text></view><view class="ui-box title-glyph"><text class="title-glyph-text">叫</text></view><view class="ui-box title-glyph"><text class="title-glyph-text">康</text></view><view class="ui-box title-glyph"><text class="title-glyph-text">彤</text></view></view>
    </distorted-title></view>
    <view class="ui-box hero-bottom">
      <view class="ui-box hero-contacts">
        <button class="ui-box ui-button contact-icon {{heroContactPanel === 'phone' ? 'contact-selected' : ''}}" hover-class="contact-pressed" data-id="phone" catchtap="toggleHeroContact" aria-label="查看电话" aria-expanded="{{heroContactPanel === 'phone'}}" aria-controls="hero-phone-panel"><view class="ui-box contact-symbol symbol-phone" /></button>
        <button class="ui-box ui-button contact-icon {{heroContactPanel === 'wechat' ? 'contact-selected' : ''}}" hover-class="contact-pressed" data-id="wechat" catchtap="toggleHeroContact" aria-label="查看微信二维码" aria-expanded="{{heroContactPanel === 'wechat'}}" aria-controls="hero-wechat-panel"><view class="ui-box contact-symbol symbol-wechat" /></button>
        <button class="ui-box ui-button contact-icon" hover-class="contact-pressed" bindtap="copyEmail" aria-label="复制邮箱"><view class="ui-box contact-symbol symbol-email" /></button>
        <view wx:if="{{heroContactPanel === 'phone'}}" id="hero-phone-panel" class="ui-box hero-contact-popover" catchtap="keepHeroContactOpen" aria-label="电话联系">
          <text class="hero-contact-label">电话联系</text>
          <button class="ui-box ui-button hero-contact-phone" hover-class="tap-pressed" bindtap="call" aria-label="拨打电话 {{contact.phoneDisplay}}">{{contact.phoneDisplay}}</button>
          <text class="hero-contact-hint">点击号码拨打电话</text>
        </view>
        <view wx:if="{{heroContactPanel === 'wechat'}}" id="hero-wechat-panel" class="ui-box hero-contact-popover hero-wechat-popover" catchtap="keepHeroContactOpen" aria-label="微信联系">
          <text class="hero-contact-label">微信联系</text>
          <view wx:if="{{!heroQrFailed}}" class="ui-box hero-contact-qr"><image class="ui-box hero-qr-image" src="{{contact.qrCode}}" mode="scaleToFill" show-menu-by-longpress="{{true}}" binderror="onHeroQrError" aria-label="康彤的微信二维码" /></view>
          <text class="hero-contact-hint">{{heroQrFailed ? '在微信中搜索下方微信号' : '微信扫一扫，或复制下方微信号'}}</text>
          <button class="ui-box ui-button hero-contact-wechat-id" hover-class="tap-pressed" bindtap="copyWechat" aria-label="复制微信号 {{contact.wechat}}">{{contact.wechat}} <text class="hero-contact-copy">复制</text></button>
        </view>
      </view>
      <button hover-class="tap-pressed" class="ui-box ui-button scroll-hint" data-id="about" bindtap="navigateSection">向下滑动 <view class="ui-box scroll-hint-arrow" aria-hidden="true" /></button>
    </view>
  </view>
  <view class="ui-box content">
    <view id="about" class="ui-box profile-section intro anchor">
      <view class="ui-box section-heading reveal reveal-container visibility-target" data-key="about"><view class="ui-box eyebrow"><view class="ui-box eyebrow-dot" aria-hidden="true" style="opacity:{{0.12 + 0.88 * copyProgress[copy.static.aboutEyebrow]}}" /><template is="copy-text" data="{{run:copyRuns[copy.static.aboutEyebrow],progress:copyProgress[copy.static.aboutEyebrow]}}" /></view><view class="ui-box section-title" style="width:130px;height:46px;"><distorted-title class="shader-title" source="/assets/titles/about.png" label="关于我" progress="{{titleProgress.about || 0}}" active="{{motionActive && !menuOpen && !contactVisible && revealed.about}}"><text>关于我<text class="dot">.</text></text></distorted-title></view></view>
      <view wx:for="{{introParagraphs}}" wx:for-index="paragraphIndex" wx:key="id" class="ui-box intro-paragraph reveal" data-key="{{item.id}}" aria-label="{{item.text}}"><text aria-hidden="true"><text wx:for="{{characterFade.runs(item, introProgress[paragraphIndex])}}" wx:for-item="segment" wx:key="id" class="intro-char" style="opacity:{{segment.opacity}}">{{segment.text}}</text></text></view>
    </view>
    <view id="works" class="ui-box profile-section anchor">
      <view class="ui-box section-heading reveal reveal-container visibility-target" data-key="works"><view class="ui-box eyebrow"><view class="ui-box eyebrow-dot" aria-hidden="true" style="opacity:{{0.12 + 0.88 * copyProgress[copy.static.worksEyebrow]}}" /><template is="copy-text" data="{{run:copyRuns[copy.static.worksEyebrow],progress:copyProgress[copy.static.worksEyebrow]}}" /></view><view class="ui-box section-title" style="width:168px;height:46px;"><distorted-title class="shader-title" source="/assets/titles/works.png" label="作品介绍" progress="{{titleProgress.works || 0}}" active="{{motionActive && !menuOpen && !contactVisible && revealed.works}}"><text>作品介绍<text class="dot">.</text></text></distorted-title></view></view>
      <view class="ui-box works-list">
        <view wx:for="{{projects}}" wx:for-index="projectIndex" wx:key="id" class="ui-box work-row reveal reveal-container visibility-target" data-key="{{item.id}}">
          <text class="work-number"><template is="copy-text" data="{{run:copyRuns[copy.projects[projectIndex].number],progress:copyProgress[copy.projects[projectIndex].number]}}" /></text>
          <view class="ui-box work-content">
            <text class="work-category"><template is="copy-text" data="{{run:copyRuns[copy.projects[projectIndex].category],progress:copyProgress[copy.projects[projectIndex].category]}}" /></text>
            <button hover-class="tap-pressed" class="ui-box ui-button work-title" data-id="{{item.id}}" bindtap="openProject" aria-label="查看{{item.title}}详情"><template is="copy-text" data="{{run:copyRuns[copy.projects[projectIndex].title],progress:copyProgress[copy.projects[projectIndex].title]}}" /></button>
            <text class="work-description"><template is="copy-text" data="{{run:copyRuns[copy.projects[projectIndex].description],progress:copyProgress[copy.projects[projectIndex].description]}}" /></text>
            <view class="ui-box tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:for-index="tagIndex" wx:key="*this" class="tag"><template is="copy-text" data="{{run:copyRuns[copy.projects[projectIndex].tags[tagIndex]],progress:copyProgress[copy.projects[projectIndex].tags[tagIndex]]}}" /></text></view>
            <button hover-class="tap-pressed" class="ui-box ui-button work reveal" data-key="image-{{item.id}}" style="{{revealStyles['image-' + item.id]}}" data-id="{{item.id}}" bindtap="openProject" aria-label="查看{{item.title}}详情">
              <image wx:if="{{!failedImages[item.id]}}" class="ui-box work-cover" src="{{item.cover}}" mode="aspectFit" lazy-load="{{true}}" data-id="{{item.id}}" binderror="onCoverError" aria-label="{{item.coverAlt}}" />
              <view wx:else="" class="ui-box image-placeholder">{{item.title}} · 查看详情</view>
              <image wx:if="{{visibleWorks[item.id] && motionActive && !contactVisible && !menuOpen && !failedMotion[item.id]}}" class="ui-box work-motion" src="{{item.motion}}" mode="aspectFit" data-id="{{item.id}}" binderror="onMotionError" aria-hidden="true" />
            </button>
          </view>
        </view>
      </view>
    </view>
    <view id="experience" class="ui-box profile-section anchor">
      <view class="ui-box section-heading reveal reveal-container visibility-target" data-key="experience"><view class="ui-box eyebrow"><view class="ui-box eyebrow-dot" aria-hidden="true" style="opacity:{{0.12 + 0.88 * copyProgress[copy.static.experienceEyebrow]}}" /><template is="copy-text" data="{{run:copyRuns[copy.static.experienceEyebrow],progress:copyProgress[copy.static.experienceEyebrow]}}" /></view><view class="ui-box section-title" style="width:168px;height:46px;"><distorted-title class="shader-title" source="/assets/titles/experience.png" label="工作经历" progress="{{titleProgress.experience || 0}}" active="{{motionActive && !menuOpen && !contactVisible && revealed.experience}}"><text>工作经历<text class="dot">.</text></text></distorted-title></view></view>
      <view wx:for="{{experiences}}" wx:for-index="experienceIndex" wx:key="id" class="ui-box career-card">
        <view class="ui-box career-heading"><view class="ui-box career-copy"><text class="career-period"><template is="copy-text" data="{{run:copyRuns[copy.experiences[experienceIndex].period],progress:copyProgress[copy.experiences[experienceIndex].period]}}" /></text><text class="career-organization"><template is="copy-text" data="{{run:copyRuns[copy.experiences[experienceIndex].organization],progress:copyProgress[copy.experiences[experienceIndex].organization]}}" /></text><text class="career-role"><template is="copy-text" data="{{run:copyRuns[copy.experiences[experienceIndex].role],progress:copyProgress[copy.experiences[experienceIndex].role]}}" /></text></view><view class="ui-box career-mark"><text class="career-number"><template is="copy-text" data="{{run:copyRuns[copy.experiences[experienceIndex].number],progress:copyProgress[copy.experiences[experienceIndex].number]}}" /></text><image class="ui-box career-logo reveal" data-key="logo-{{item.id}}" style="{{revealStyles['logo-' + item.id]}}" src="{{item.logo}}" mode="aspectFit" aria-hidden="true" /></view></view>
        <text class="career-description"><template is="copy-text" data="{{run:copyRuns[copy.experiences[experienceIndex].description],progress:copyProgress[copy.experiences[experienceIndex].description]}}" /></text><view class="ui-box tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:for-index="tagIndex" wx:key="*this" class="tag"><template is="copy-text" data="{{run:copyRuns[copy.experiences[experienceIndex].tags[tagIndex]],progress:copyProgress[copy.experiences[experienceIndex].tags[tagIndex]]}}" /></text></view>
      </view>
    </view>
    <view id="skills" class="ui-box profile-section anchor">
      <view class="ui-box section-heading reveal reveal-container visibility-target" data-key="skills"><view class="ui-box eyebrow"><view class="ui-box eyebrow-dot" aria-hidden="true" style="opacity:{{0.12 + 0.88 * copyProgress[copy.static.skillsEyebrow]}}" /><template is="copy-text" data="{{run:copyRuns[copy.static.skillsEyebrow],progress:copyProgress[copy.static.skillsEyebrow]}}" /></view><view class="ui-box section-title" style="width:168px;height:46px;"><distorted-title class="shader-title" source="/assets/titles/skills.png" label="我的技能" progress="{{titleProgress.skills || 0}}" active="{{motionActive && !menuOpen && !contactVisible && revealed.skills}}"><text>我的技能<text class="dot">.</text></text></distorted-title></view></view>
      <view class="ui-box skills-grid"><block wx:for="{{skills}}" wx:for-index="skillIndex" wx:key="id"><view wx:if="{{skillIndex < 6 || skillsExpanded}}" class="ui-box skill-card"><text class="skill-number"><template is="copy-text" data="{{run:copyRuns[copy.skills[skillIndex].number],progress:copyProgress[copy.skills[skillIndex].number]}}" /></text><view class="ui-box skill-copy"><text class="skill-name"><template is="copy-text" data="{{run:copyRuns[copy.skills[skillIndex].name],progress:copyProgress[copy.skills[skillIndex].name]}}" /></text><text class="skill-label"><template is="copy-text" data="{{run:copyRuns[copy.skills[skillIndex].label],progress:copyProgress[copy.skills[skillIndex].label]}}" /></text></view><image class="ui-box skill-icon" style="opacity:{{0.12 + 0.88 * copyProgress[copy.skills[skillIndex].name]}}" src="{{item.icon}}" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true" /></view></block></view>
      <button hover-class="tap-pressed" class="ui-box ui-button skills-toggle reveal" data-key="skills-toggle" style="{{revealStyles['skills-toggle']}}" bindtap="toggleSkills" aria-expanded="{{skillsExpanded}}">{{skillsExpanded ? '收起技能 −' : '展开所有技能 ＋'}}</button>
    </view>
    <view id="contact" class="ui-box profile-section contact-section anchor">
      <view class="ui-box section-heading reveal reveal-container visibility-target" data-key="contact"><view class="ui-box eyebrow"><view class="ui-box eyebrow-dot" aria-hidden="true" style="opacity:{{0.12 + 0.88 * copyProgress[copy.static.contactEyebrow]}}" /><template is="copy-text" data="{{run:copyRuns[copy.static.contactEyebrow],progress:copyProgress[copy.static.contactEyebrow]}}" /></view><view class="ui-box section-title" style="width:156px;height:55.2px;"><distorted-title class="shader-title" source="/assets/titles/contact.png" label="联系我" progress="{{titleProgress.contact || 0}}" active="{{motionActive && !menuOpen && !contactVisible && revealed.contact}}"><text>联系我<text class="dot">.</text></text></distorted-title></view></view>
      <text class="contact-invitation"><template is="copy-text" data="{{run:copyRuns[copy.static.contactInvitation],progress:copyProgress[copy.static.contactInvitation]}}" /></text><text class="contact-description"><template is="copy-text" data="{{run:copyRuns[copy.static.contactDescription],progress:copyProgress[copy.static.contactDescription]}}" /></text>
      <view class="ui-box contact-methods">
        <view class="ui-box contact-method"><text class="contact-label"><text class="contact-number" style="opacity:{{0.12 + 0.88 * copyProgress[copy.static.phoneLabel]}}">01</text> <template is="copy-text" data="{{run:copyRuns[copy.static.phoneLabel],progress:copyProgress[copy.static.phoneLabel]}}" /></text><button hover-class="tap-pressed" class="ui-box ui-button contact-action" bindtap="call" aria-label="拨打电话 {{contact.phoneDisplay}}"><text class="contact-value"><template is="copy-text" data="{{run:copyRuns[copy.static.phoneValue],progress:copyProgress[copy.static.phoneValue]}}" /></text><text class="action-label"><template is="copy-text" data="{{run:copyRuns[copy.static.phoneAction],progress:copyProgress[copy.static.phoneAction]}}" /></text></button></view>
        <view class="ui-box contact-method"><text class="contact-label"><text class="contact-number" style="opacity:{{0.12 + 0.88 * copyProgress[copy.static.wechatLabel]}}">02</text> <template is="copy-text" data="{{run:copyRuns[copy.static.wechatLabel],progress:copyProgress[copy.static.wechatLabel]}}" /></text><button hover-class="tap-pressed" class="ui-box ui-button contact-action" bindtap="copyWechat" aria-label="复制微信号 {{contact.wechat}}"><text class="contact-value"><template is="copy-text" data="{{run:copyRuns[copy.static.wechatValue],progress:copyProgress[copy.static.wechatValue]}}" /></text><text class="action-label"><template is="copy-text" data="{{run:copyRuns[copy.static.wechatAction],progress:copyProgress[copy.static.wechatAction]}}" /></text></button><button hover-class="tap-pressed" class="ui-box ui-button qr-link" bindtap="showContact" aria-label="查看二维码"><template is="copy-text" data="{{run:copyRuns[copy.static.qrAction],progress:copyProgress[copy.static.qrAction]}}" /></button></view>
        <view class="ui-box contact-method"><text class="contact-label"><text class="contact-number" style="opacity:{{0.12 + 0.88 * copyProgress[copy.static.emailLabel]}}">03</text> <template is="copy-text" data="{{run:copyRuns[copy.static.emailLabel],progress:copyProgress[copy.static.emailLabel]}}" /></text><button hover-class="tap-pressed" class="ui-box ui-button contact-action" bindtap="copyEmail" aria-label="复制邮箱 {{contact.email}}"><text class="contact-value"><template is="copy-text" data="{{run:copyRuns[copy.static.emailValue],progress:copyProgress[copy.static.emailValue]}}" /></text><text class="action-label"><template is="copy-text" data="{{run:copyRuns[copy.static.emailAction],progress:copyProgress[copy.static.emailAction]}}" /></text></button></view>
      </view>
    </view>
    <view class="ui-box home-footer"><text>{{profile.studio}}</text></view>
  </view>
  <button hover-class="tap-pressed" wx:if="{{showBackTop && !contactVisible && !menuOpen}}" class="ui-box ui-button back-top" bindtap="backToTop" aria-label="返回顶部">↑</button>
</view>
<contact-sheet class="contact-sheet" visible="{{contactVisible}}" bindclose="closeContact" />
