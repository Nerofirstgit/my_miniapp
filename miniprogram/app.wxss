page { background: #111; color: #f5f5ef; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; line-height: 1.7; }
.ui-box { box-sizing: border-box; }
.ui-button { margin: 0; padding: 0; border-radius: 0; background: transparent; color: inherit; font-size: inherit; line-height: inherit; }
.ui-button::after { border: 0; }
/* Replace the native light button hover background without changing each button's fill. */
.ui-button.tap-pressed { opacity: .72; }

.page { padding: 0 36rpx; }
.muted { color: #b2b2aa; }
.section { padding: 64rpx 0; border-top: 1rpx solid #ffffff24; }
.section-title { display: block; margin-bottom: 30rpx; font-size: 44rpx; line-height: 1.3; font-weight: 700; letter-spacing: -1rpx; }
.paragraph { display: block; margin-bottom: 20rpx; color: #c6c6bd; font-size: 28rpx; line-height: 1.9; }
.tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { padding: 8rpx 18rpx; border: 1rpx solid #ffffff30; border-radius: 50rpx; color: #c6c6bd; font-size: 23rpx; }
/* 双类选择器覆盖 style v2 的默认按钮宽度和内边距，避免使用标签选择器。 */
.ui-button.primary { display: flex; justify-content: center; align-items: center; width: 100%; min-width: 0; margin: 0; min-height: 96rpx; padding: 20rpx 30rpx; border-radius: 10rpx; background: #e4ff4e; color: #111; font-weight: 600; }
.ui-button.secondary { display: flex; justify-content: center; align-items: center; width: 100%; min-width: 0; margin: 0; min-height: 96rpx; padding: 20rpx 30rpx; border: 1rpx solid #ffffff40; border-radius: 10rpx; }
.footer { padding: 44rpx 0 calc(44rpx + env(safe-area-inset-bottom)); color: #b2b2aa; font-size: 23rpx; }
.image-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; aspect-ratio: 16 / 9; background: #252525; color: #c6c6bd; font-size: 26rpx; }
