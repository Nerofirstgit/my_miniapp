.ui-box { box-sizing: border-box; }
:host { display: block; font-size: inherit; font-weight: inherit; line-height: inherit; letter-spacing: inherit; }
.title-host { position: relative; width: 100%; }
.hero-host { aspect-ratio: 1.65; max-height: 420px; display: flex; align-items: center; justify-content: center; }
.hero-host .title-fallback { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; }
.hero-static { display: block; width: 100%; height: 100%; animation: hero-appear 1.4s ease-out backwards; }
.entrance-paused { animation-play-state: paused; }
@keyframes hero-appear { from { opacity: 0; } to { opacity: 1; } }
.title-fallback { opacity: 1; }
.section-fallback { font-size: inherit; font-weight: inherit; line-height: inherit; letter-spacing: inherit; color: #f4f4f1; }
.fallback-character.accent { color: #e4ff4e; }
.title-canvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; }
.is-rendered .title-fallback { opacity: 0; }
.is-rendered .title-canvas { opacity: 1; }
@media (prefers-reduced-motion: reduce) {
  .hero-static { animation: none; }
  .is-rendered .title-fallback { opacity: 1; }
  .fallback-character { opacity: 1 !important; }
  .title-canvas { display: none; }
}
